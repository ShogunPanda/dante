{
  "name": "@perseveranza-pets/dante",
  "version": "2.1.1",
  "description": "Opinionated static site generator.",
  "homepage": "https://sw.cowtech.it/dante",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShogunPanda/dante.git"
  },
  "keywords": [
    "slides"
  ],
  "bugs": {
    "url": "https://github.com/ShogunPanda/dante/issues"
  },
  "author": "Shogun <shogun@cowtech.it>",
  "license": "ISC",
  "private": false,
  "bin": {
    "dante": "bin/dante",
    "create-dante-site": "bin/create-dante-site"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -a src/assets src/templates dist && npm run lint",
    "format": "prettier -w src",
    "lint": "eslint --cache",
    "test": "exit 0",
    "ci": "npm run build && npm run test",
    "prepublishOnly": "npm run ci",
    "postpublish": "git push origin && git push origin -f --tags"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "fastify-http-errors-enhanced": "^8.0.0",
    "glob": "^13.0.6",
    "http-errors-enhanced": "^5.0.0",
    "js-yaml": "^5.4.2",
    "lightningcss": "^1.33.0",
    "oxc-transform": "^0.152.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@cowtech/eslint-config": "^12.0.1",
    "@cowtech/typescript-config": "^1.0.0",
    "@eslint/compat": "^2.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">= 22.21.0"
  }
}
